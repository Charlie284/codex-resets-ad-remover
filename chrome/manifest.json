{
  "manifest_version": 3,
  "name": "Codex Resets Ad Remover",
  "version": "1.0.0",
  "description": "Removes sponsor placements from codex-resets.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codex-resets.com/*"
      ],
      "css": [
        "blocker.css"
      ],
      "run_at": "document_start"
    }
  ]
}
